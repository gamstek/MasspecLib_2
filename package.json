{
  "name": "masspeclib2",
  "version": "2.8.67",
  "description": "MasspecLib2 谱图库软件",
  "main": "./out/main/index.js",
  "author": "合肥引力波智谱科技有限公司",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "ms:dedupe": "node scripts/deduplicate-ms-methods.mjs",
    "ms:dedupe:apply": "node scripts/deduplicate-ms-methods.mjs --apply",
    "dev": "electron-vite dev",
    "ms:dedupe:clean": "node scripts/deduplicate-ms-methods.mjs --apply --no-backup --no-report",
    "db:gen": "prisma generate",
    "nist:match": "node scripts/import-nist-mspec.mjs",
    "nist:import": "node scripts/import-nist-mspec.mjs --apply",
    "mrm:import": "node scripts/import-mrm-csv.mjs --apply",
    "categorized:import": "node scripts/import-categorized-compound-spectra.mjs --apply",
    "compounds:prune:no-spectrum": "node scripts/delete-compounds-without-spectra.mjs --apply",
    "classes:sync:polarity": "node scripts/sync-ion-polarity-classes.mjs --apply",
    "compounds:enrich": "node scripts/enrich-compounds.mjs --fetch",
    "compounds:enrich:apply": "node scripts/enrich-compounds.mjs --fetch --apply",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:init-file": "node scripts/generate-initialization.mjs",
    "data:convert": "node --experimental-strip-types scripts/convert-source.mjs",
    "build:win:preview": "npm run build && electron-builder --win --dir -c.win.signAndEditExecutable=false",
    "unified:inspect": "python scripts/unified-library/inspect_dump.py",
    "unified:convert": "node --experimental-strip-types scripts/unified-library/convert-unified.mjs",
    "public:audit": "python scripts/public-library/audit.py",
    "public:export": "python scripts/public-library/export-staging.py",
    "public:package": "node --experimental-strip-types scripts/public-library/package-staging.mjs",
    "delivery:test": "node --test scripts/customer-delivery/test.cjs scripts/customer-delivery/indexed-offline.test.cjs scripts/customer-delivery/source-updates.test.cjs",
    "delivery:integration": "node scripts/customer-delivery/integration.cjs",
    "delivery:build-editions": "npm run build && node scripts/customer-delivery/build-editions.cjs",
    "novice:start": "node scripts/novice-start.cjs",
    "novice:check": "node scripts/novice-start.cjs --check"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@prisma/adapter-mariadb": "7.1.0",
    "@prisma/client": "7.1.0",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.6.3",
    "fflate": "^0.8.2",
    "lodash": "^4.17.21",
    "mariadb": "^3.4.5",
    "mysql2": "^3.15.3",
    "openchemlib": "^9.24.0",
    "pg": "^8.16.3",
    "ssh2": "1.17.0",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.4.0",
    "less": "^4.4.2",
    "prettier": "^3.6.2",
    "prisma": "7.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.1.6",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  }
}
